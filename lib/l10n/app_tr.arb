  "themeTitle": "Tema",
  "themeSystem": "Sistem",
  "themeLight": "Aydınlık",
  "themeDark": "Karanlık",

  "clearSavedTitle": "Kaydedilenleri Temizle",
  "clearButton": "Temizle",
